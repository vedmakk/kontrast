{
  "name": "kontrast",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "vite build",
    "preview": "bunx --bun vite preview",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
